# TTS Node.js Example — Environment Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# Your vcall-seamless API key
API_KEY=your_api_key_here

# Base URL of the vcall-seamless API (no trailing slash)
API_HOST=https://sdk.verbum.ai

# Path prefix for the API (empty for localhost; /v1 for k8s / staging / production)
# Leave empty when running against localhost:3000 — the /v1 prefix is added by the
# k8s ingress and is NOT present on the local NestJS server.
API_PATH_PREFIX=/v1

# Voice to use for synthesis (run `npm run http` with LIST_VOICES=true to see available voices)
# Example: en-US-AriaNeural, en-US-GuyNeural, es-ES-AlvaroNeural
VOICE=en-US-AriaNeural

# Audio format for output files
# Common options: Audio16Khz128KBitMp3, Audio24Khz160KBitMp3, Audio48Khz192KBitMp3
AUDIO_FORMAT=Audio16Khz128KBitMp3

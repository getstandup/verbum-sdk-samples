# Example environment configuration
# Copy this file to .env and update with your actual values

# WebSocket Server Configuration
WEBSOCKET_URL=ws://localhost:3000

# Authentication
API_KEY=your-api-key-here

# Audio Configuration
AUDIO_FILE=sample-audio.wav
CHUNK_SIZE=4096
STREAMING_INTERVAL_MS=100

# STT Configuration
LANGUAGE=en-US
ENCODING=wav
PROFANITY_FILTER=false
DIARIZATION=false
ANALYZE_SENTIMENTS=false

# Translation Settings
TRANSLATE_TO=
TRANSLATE_MODEL=standard

# PII Redaction
REDACT_CATEGORIES=

# Custom Tags (JSON string)
TAGS={"session":"file-demo","environment":"development"}
